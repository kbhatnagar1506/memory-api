# Copy to .env. Every value below is optional; defaults run with zero setup.

SUPERMEMORY_ENVIRONMENT=local
SUPERMEMORY_LOG_LEVEL=INFO
SUPERMEMORY_LOG_JSON=false

# storage: memory | postgres
SUPERMEMORY_STORE_BACKEND=memory
SUPERMEMORY_DATABASE_URL=postgresql+asyncpg://supermemory:supermemory@localhost:5432/supermemory

# embeddings: deterministic | gemini | openai
# `deterministic` is offline and needs no credentials, but is not semantic;
# production validation refuses to start with it.
SUPERMEMORY_EMBEDDING_BACKEND=deterministic
SUPERMEMORY_EMBEDDING_MODEL=text-embedding-004
SUPERMEMORY_EMBEDDING_DIMENSIONS=768

# reranking: none | heuristic | llm
SUPERMEMORY_RERANK_BACKEND=heuristic
SUPERMEMORY_RERANK_MODEL=gemini-2.5-flash

# Gemini via Vertex AI uses Application Default Credentials:
#   gcloud auth application-default login
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# ... or the Gemini Developer API with a key instead:
GEMINI_API_KEY=
OPENAI_API_KEY=

# security
SUPERMEMORY_API_KEY_PEPPER=change-me-in-production
SUPERMEMORY_RATE_LIMIT_PER_MINUTE=600
SUPERMEMORY_REDIS_URL=

# Development only. Seeds an org, space and admin key at boot.
SUPERMEMORY_BOOTSTRAP_ADMIN_KEY=
