# Copy to .env. Every value below is optional; defaults run with zero setup.

MAPI_ENVIRONMENT=local
MAPI_LOG_LEVEL=INFO
MAPI_LOG_JSON=false

# storage: memory | postgres
MAPI_STORE_BACKEND=memory
MAPI_DATABASE_URL=postgresql+asyncpg://mapi:mapi@localhost:5432/mapi

# embeddings: deterministic | gemini | openai
# `deterministic` is offline and needs no credentials, but is not semantic;
# production validation refuses to start with it.
MAPI_EMBEDDING_BACKEND=deterministic
MAPI_EMBEDDING_MODEL=gemini-embedding-001
MAPI_EMBEDDING_DIMENSIONS=768
# Texts per embedding request. The Gemini Developer API caps this at 100.
MAPI_EMBEDDING_BATCH_SIZE=32
# Embedding batches in flight at once, per request (bulk ingest).
MAPI_EMBEDDING_CONCURRENCY=2
# Query embeddings: per-attempt deadline, attempts (2 = one retry), and an
# optional hedge in ms (0 = off; pauses itself for 60 s after any 429).
MAPI_QUERY_EMBEDDING_TIMEOUT_S=1.2
MAPI_QUERY_EMBEDDING_ATTEMPTS=2
MAPI_QUERY_EMBEDDING_HEDGE_MS=0
# Longest Retry-After a write will wait on before failing with the hint.
MAPI_EMBEDDING_MAX_RETRY_DELAY_S=30

# reranking: none | heuristic | llm
MAPI_RERANK_BACKEND=heuristic
MAPI_RERANK_MODEL=gemini-2.5-flash

# Gemini via Vertex AI uses Application Default Credentials:
#   gcloud auth application-default login
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# ... or the Gemini Developer API with a key instead:
GEMINI_API_KEY=
OPENAI_API_KEY=

# security
MAPI_API_KEY_PEPPER=change-me-in-production
MAPI_RATE_LIMIT_PER_MINUTE=600
MAPI_REDIS_URL=

# Development only. Seeds an org, space and admin key at boot.
MAPI_BOOTSTRAP_ADMIN_KEY=
