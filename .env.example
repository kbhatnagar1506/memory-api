# Provider credentials.
#
# Google Vertex AI (Gemini, and optionally Claude) uses Application Default
# Credentials -- no key needed. Run once:
#     gcloud auth application-default login
# then set:
GOOGLE_CLOUD_PROJECT=your-gcp-project
GOOGLE_CLOUD_LOCATION=us-central1

# Anthropic. Either a direct API key ...
ANTHROPIC_API_KEY=
# ... or leave it blank and set MAPI_ANTHROPIC_BACKEND=vertex to route Claude
# through Vertex AI with the same ADC above.
MAPI_ANTHROPIC_BACKEND=api

# Gemini. Leave blank to use Vertex AI + ADC (preferred); set a key to use the
# public Gemini Developer API instead.
GEMINI_API_KEY=

# OpenAI has no ADC path -- a key is required for the openai provider.
OPENAI_API_KEY=
